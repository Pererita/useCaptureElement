{
  "name": "use-capture-element-workspace",
  "private": true,
  "description": "Monorepo para useCaptureElement",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev:example": "pnpm --filter example-app dev",
    "build:lib": "pnpm --filter use-capture-element build",
    "build:example": "pnpm --filter example-app build",
    "test:lib": "pnpm --filter use-capture-element test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.12",
      "vite": "^6.4.3",
      "postcss": "^8.5.10"
    }
  }
}
